APP_TIME_ZONE=Africa/Lagos
# Nettoyage quotidien des rapports à 21:00 (seconde minute heure jour mois semaine).
REPORT_RETENTION_CLEANUP_CRON="0 0 21 * * *"
# Tolérance Docker pour le démarrage à froid des services Spring Boot.
BACKEND_HEALTH_START_PERIOD=300s

# --- Production active --------------------------------------------------------
COMPOSE_PROFILES=prod
COOKIE_SECURE=true
FINTRACK_DNS_NAME=fintrack.fintrack.org
FRONTEND_URL=https://fintrack.fintrack.org
ALLOWED_ORIGINS=https://fintrack.fintrack.org
VITE_API_BASE_URL=


# --- PostgreSQL ---------------------------------------------------------------
DB_USER=fintrack
DB_PASSWORD=replace-with-strong-postgres-password

# --- MongoDB ------------------------------------------------------------------
MONGO_ROOT_USER=fintrack_mongo_admin
MONGO_ROOT_PASSWORD=replace-with-strong-mongo-password

# --- Authentification et appels internes -------------------------------------
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION=43200000
JWT_REFRESH_EXPIRATION=604800000
INTERNAL_SERVICE_TOKEN=replace-with-long-random-internal-token
TEMP_PASSWORD_SECRET=replace-with-at-least-32-random-bytes

# --- SMTP ---------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-app-password
SMTP_FROM=no-reply@fintrack.example.com
MAIL_FROM_NAME=FinTrack
SMTP_SSL_TRUST=smtp.example.com

# --- Super administrateur initial --------------------------------------------
SUPER_ADMIN_BOOTSTRAP_ENABLED=true
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_EMAIL=admin@fintrack.example.com
SUPER_ADMIN_PASSWORD=replace-with-strong-admin-password

# --- MinIO --------------------------------------------------------------------
MINIO_ROOT_USER=fintrack_minio_admin
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password

# --- Reglages metier ----------------------------------------------------------
DEFAULT_SLA_HOURS=24

# Configuration de la sauvegarde Cloud Backblaze B2
B2_BUCKET_NAME=name-bucket
B2_KEY_ID=key
B2_APPLICATION_KEY=application-key
